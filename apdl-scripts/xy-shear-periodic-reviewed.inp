! Full RVE XY shear: periodic constraint equations
! GAM is the engineering XY shear strain.
! Original solver commands and CE constants are retained.

!   Commands inserted into this file will be executed just prior to the ANSYS SOLVE command.
!   These commands may supersede command settings set by Workbench.

!   Active UNIT system in Workbench when this object was created:  Metric (m, kg, N, s, V, A)
!   NOTE:  Any data that requires units (such as mass) is assumed to be in the consistent solver unit system.
!                See Solving Units in the help system for more information.




! FULL PERIODIC RVE - SIXTH COLUMN OF C
! Compute C66 = G12
! Based on Barbero Eqs. 6.30 and 6.35-6.39
!
! Global axes: X = fibre (1), Y = 2, Z = 3
! x1 = global X = fibre direction
! x2 = global Y
! x3 = global Z
!
! Applied engineering shear: gamma_XY = 0.01

/PREP7
ALLSEL,ALL
CSYS,0

! Delete any previously generated constraint equations
CEDELE,ALL

! 1. APPLIED SHEAR AND MODEL DIMENSIONS

GAM = 0.01

*GET,XMIN,NODE,0,MNLOC,X
*GET,XMAX,NODE,0,MXLOC,X
*GET,YMIN,NODE,0,MNLOC,Y
*GET,YMAX,NODE,0,MXLOC,Y
*GET,ZMIN,NODE,0,MNLOC,Z
*GET,ZMAX,NODE,0,MXLOC,Z

LX = XMAX-XMIN
LY = YMAX-YMIN
LZ = ZMAX-ZMIN

! gamma12 = epsilon12 + epsilon21
! Half is imposed across each pair of periodic faces

DUYX = 0.5*GAM*LX
DUXY = 0.5*GAM*LY

! Coordinate-selection tolerance
TOL = 1e-10

! Pair-check tolerance
PAIRTOL = 1e-12

BADPAIR = 0

! Suppress thousands of APDL output lines during CE creation

/NOPR


! 2. XMIN <-> XMAX FACE INTERIOR
! Barbero Eq. 6.30
!
! UX(Xmax)-UX(Xmin) = 0
! UY(Xmax)-UY(Xmin) = DUYX
! UZ(Xmax)-UZ(Xmin) = 0

NSEL,S,LOC,X,XMIN-TOL,XMIN+TOL
NSEL,R,LOC,Y,YMIN+TOL,YMAX-TOL
NSEL,R,LOC,Z,ZMIN+TOL,ZMAX-TOL

*GET,NXINT,NODE,0,COUNT
*DIM,X0NODE,ARRAY,NXINT

NN=0
*DO,II,1,NXINT
    NN=NDNEXT(NN)
    X0NODE(II)=NN
*ENDDO

! IMPORTANT: select ONLY opposite target face
NSEL,S,LOC,X,XMAX-TOL,XMAX+TOL

*DO,II,1,NXINT

    N0=X0NODE(II)
    YY=NY(N0)
    ZZ=NZ(N0)

    N1=NODE(XMAX,YY,ZZ)

    *IF,N1,GT,0,THEN

        DERR=ABS(NY(N1)-YY)+ABS(NZ(N1)-ZZ)

        *IF,DERR,LE,PAIRTOL,THEN
            CE,NEXT,0,    N1,UX,1,N0,UX,-1
            CE,NEXT,DUYX, N1,UY,1,N0,UY,-1
            CE,NEXT,0,    N1,UZ,1,N0,UZ,-1
        *ELSE
            BADPAIR=BADPAIR+1
        *ENDIF

    *ELSE
        BADPAIR=BADPAIR+1
    *ENDIF

*ENDDO


! 3. YMIN <-> YMAX FACE INTERIOR
! Barbero Eq. 6.30
!
! UX(Ymax)-UX(Ymin) = DUXY
! UY(Ymax)-UY(Ymin) = 0
! UZ(Ymax)-UZ(Ymin) = 0

ALLSEL,ALL

NSEL,S,LOC,Y,YMIN-TOL,YMIN+TOL
NSEL,R,LOC,X,XMIN+TOL,XMAX-TOL
NSEL,R,LOC,Z,ZMIN+TOL,ZMAX-TOL

*GET,NYINT,NODE,0,COUNT
*DIM,Y0NODE,ARRAY,NYINT

NN=0
*DO,II,1,NYINT
    NN=NDNEXT(NN)
    Y0NODE(II)=NN
*ENDDO

! Target face only
NSEL,S,LOC,Y,YMAX-TOL,YMAX+TOL

*DO,II,1,NYINT

    N0=Y0NODE(II)
    XX=NX(N0)
    ZZ=NZ(N0)

    N1=NODE(XX,YMAX,ZZ)

    *IF,N1,GT,0,THEN

        DERR=ABS(NX(N1)-XX)+ABS(NZ(N1)-ZZ)

        *IF,DERR,LE,PAIRTOL,THEN
            CE,NEXT,DUXY, N1,UX,1,N0,UX,-1
            CE,NEXT,0,    N1,UY,1,N0,UY,-1
            CE,NEXT,0,    N1,UZ,1,N0,UZ,-1
        *ELSE
            BADPAIR=BADPAIR+1
        *ENDIF

    *ELSE
        BADPAIR=BADPAIR+1
    *ENDIF

*ENDDO


! 4. ZMIN <-> ZMAX FACE INTERIOR
! Barbero Eq. 6.30
!
! All displacement differences = 0

ALLSEL,ALL

NSEL,S,LOC,Z,ZMIN-TOL,ZMIN+TOL
NSEL,R,LOC,X,XMIN+TOL,XMAX-TOL
NSEL,R,LOC,Y,YMIN+TOL,YMAX-TOL

*GET,NZINT,NODE,0,COUNT
*DIM,Z0NODE,ARRAY,NZINT

NN=0
*DO,II,1,NZINT
    NN=NDNEXT(NN)
    Z0NODE(II)=NN
*ENDDO

! Target face only
NSEL,S,LOC,Z,ZMAX-TOL,ZMAX+TOL

*DO,II,1,NZINT

    N0=Z0NODE(II)
    XX=NX(N0)
    YY=NY(N0)

    N1=NODE(XX,YY,ZMAX)

    *IF,N1,GT,0,THEN

        DERR=ABS(NX(N1)-XX)+ABS(NY(N1)-YY)

        *IF,DERR,LE,PAIRTOL,THEN
            CE,NEXT,0,N1,UX,1,N0,UX,-1
            CE,NEXT,0,N1,UY,1,N0,UY,-1
            CE,NEXT,0,N1,UZ,1,N0,UZ,-1
        *ELSE
            BADPAIR=BADPAIR+1
        *ENDIF

    *ELSE
        BADPAIR=BADPAIR+1
    *ENDIF

*ENDDO


! 5. XY EDGE PAIR A
! Barbero Eq. 6.35
!
! (XMAX,YMAX) <-> (XMIN,YMIN)

ALLSEL,ALL

NSEL,S,LOC,X,XMAX-TOL,XMAX+TOL
NSEL,R,LOC,Y,YMAX-TOL,YMAX+TOL
NSEL,R,LOC,Z,ZMIN+TOL,ZMAX-TOL

*GET,NE1,NODE,0,COUNT
*DIM,E1NODE,ARRAY,NE1

NN=0
*DO,II,1,NE1
    NN=NDNEXT(NN)
    E1NODE(II)=NN
*ENDDO

! Target edge only
ALLSEL,ALL
NSEL,S,LOC,X,XMIN-TOL,XMIN+TOL
NSEL,R,LOC,Y,YMIN-TOL,YMIN+TOL
NSEL,R,LOC,Z,ZMIN+TOL,ZMAX-TOL

*DO,II,1,NE1

    N1=E1NODE(II)
    ZZ=NZ(N1)

    N0=NODE(XMIN,YMIN,ZZ)

    CE,NEXT, DUXY,N1,UX,1,N0,UX,-1
    CE,NEXT, DUYX,N1,UY,1,N0,UY,-1
    CE,NEXT, 0,    N1,UZ,1,N0,UZ,-1

*ENDDO


! 6. XY EDGE PAIR B
! Barbero Eq. 6.36
!
! (XMAX,YMIN) <-> (XMIN,YMAX)

ALLSEL,ALL

NSEL,S,LOC,X,XMAX-TOL,XMAX+TOL
NSEL,R,LOC,Y,YMIN-TOL,YMIN+TOL
NSEL,R,LOC,Z,ZMIN+TOL,ZMAX-TOL

*GET,NE2,NODE,0,COUNT
*DIM,E2NODE,ARRAY,NE2

NN=0
*DO,II,1,NE2
    NN=NDNEXT(NN)
    E2NODE(II)=NN
*ENDDO

ALLSEL,ALL
NSEL,S,LOC,X,XMIN-TOL,XMIN+TOL
NSEL,R,LOC,Y,YMAX-TOL,YMAX+TOL
NSEL,R,LOC,Z,ZMIN+TOL,ZMAX-TOL

*DO,II,1,NE2

    N1=E2NODE(II)
    ZZ=NZ(N1)

    N0=NODE(XMIN,YMAX,ZZ)

    CE,NEXT,-DUXY,N1,UX,1,N0,UX,-1
    CE,NEXT, DUYX,N1,UY,1,N0,UY,-1
    CE,NEXT, 0,    N1,UZ,1,N0,UZ,-1

*ENDDO


! 7. XZ EDGE PAIR A
! Barbero Eq. 6.37
!
! (XMAX,ZMAX) <-> (XMIN,ZMIN)

ALLSEL,ALL

NSEL,S,LOC,X,XMAX-TOL,XMAX+TOL
NSEL,R,LOC,Z,ZMAX-TOL,ZMAX+TOL
NSEL,R,LOC,Y,YMIN+TOL,YMAX-TOL

*GET,NE3,NODE,0,COUNT
*DIM,E3NODE,ARRAY,NE3

NN=0
*DO,II,1,NE3
    NN=NDNEXT(NN)
    E3NODE(II)=NN
*ENDDO

ALLSEL,ALL
NSEL,S,LOC,X,XMIN-TOL,XMIN+TOL
NSEL,R,LOC,Z,ZMIN-TOL,ZMIN+TOL
NSEL,R,LOC,Y,YMIN+TOL,YMAX-TOL

*DO,II,1,NE3

    N1=E3NODE(II)
    YY=NY(N1)

    N0=NODE(XMIN,YY,ZMIN)

    CE,NEXT,0,    N1,UX,1,N0,UX,-1
    CE,NEXT,DUYX, N1,UY,1,N0,UY,-1
    CE,NEXT,0,    N1,UZ,1,N0,UZ,-1

*ENDDO


! 8. XZ EDGE PAIR B
! Barbero Eq. 6.37
!
! (XMAX,ZMIN) <-> (XMIN,ZMAX)

ALLSEL,ALL

NSEL,S,LOC,X,XMAX-TOL,XMAX+TOL
NSEL,R,LOC,Z,ZMIN-TOL,ZMIN+TOL
NSEL,R,LOC,Y,YMIN+TOL,YMAX-TOL

*GET,NE4,NODE,0,COUNT
*DIM,E4NODE,ARRAY,NE4

NN=0
*DO,II,1,NE4
    NN=NDNEXT(NN)
    E4NODE(II)=NN
*ENDDO

ALLSEL,ALL
NSEL,S,LOC,X,XMIN-TOL,XMIN+TOL
NSEL,R,LOC,Z,ZMAX-TOL,ZMAX+TOL
NSEL,R,LOC,Y,YMIN+TOL,YMAX-TOL

*DO,II,1,NE4

    N1=E4NODE(II)
    YY=NY(N1)

    N0=NODE(XMIN,YY,ZMAX)

    CE,NEXT,0,    N1,UX,1,N0,UX,-1
    CE,NEXT,DUYX, N1,UY,1,N0,UY,-1
    CE,NEXT,0,    N1,UZ,1,N0,UZ,-1

*ENDDO


! 9. YZ EDGE PAIR A
! Barbero Eq. 6.38
!
! (YMAX,ZMAX) <-> (YMIN,ZMIN)

ALLSEL,ALL

NSEL,S,LOC,Y,YMAX-TOL,YMAX+TOL
NSEL,R,LOC,Z,ZMAX-TOL,ZMAX+TOL
NSEL,R,LOC,X,XMIN+TOL,XMAX-TOL

*GET,NE5,NODE,0,COUNT
*DIM,E5NODE,ARRAY,NE5

NN=0
*DO,II,1,NE5
    NN=NDNEXT(NN)
    E5NODE(II)=NN
*ENDDO

ALLSEL,ALL
NSEL,S,LOC,Y,YMIN-TOL,YMIN+TOL
NSEL,R,LOC,Z,ZMIN-TOL,ZMIN+TOL
NSEL,R,LOC,X,XMIN+TOL,XMAX-TOL

*DO,II,1,NE5

    N1=E5NODE(II)
    XX=NX(N1)

    N0=NODE(XX,YMIN,ZMIN)

    CE,NEXT,DUXY,N1,UX,1,N0,UX,-1
    CE,NEXT,0,    N1,UY,1,N0,UY,-1
    CE,NEXT,0,    N1,UZ,1,N0,UZ,-1

*ENDDO


! 10. YZ EDGE PAIR B
! Barbero Eq. 6.38
!
! (YMAX,ZMIN) <-> (YMIN,ZMAX)

ALLSEL,ALL

NSEL,S,LOC,Y,YMAX-TOL,YMAX+TOL
NSEL,R,LOC,Z,ZMIN-TOL,ZMIN+TOL
NSEL,R,LOC,X,XMIN+TOL,XMAX-TOL

*GET,NE6,NODE,0,COUNT
*DIM,E6NODE,ARRAY,NE6

NN=0
*DO,II,1,NE6
    NN=NDNEXT(NN)
    E6NODE(II)=NN
*ENDDO

ALLSEL,ALL
NSEL,S,LOC,Y,YMIN-TOL,YMIN+TOL
NSEL,R,LOC,Z,ZMAX-TOL,ZMAX+TOL
NSEL,R,LOC,X,XMIN+TOL,XMAX-TOL

*DO,II,1,NE6

    N1=E6NODE(II)
    XX=NX(N1)

    N0=NODE(XX,YMIN,ZMAX)

    CE,NEXT,DUXY,N1,UX,1,N0,UX,-1
    CE,NEXT,0,    N1,UY,1,N0,UY,-1
    CE,NEXT,0,    N1,UZ,1,N0,UZ,-1

*ENDDO


! 11. CORNER VERTICES
! Barbero Eq. 6.39

ALLSEL,ALL

! ----- Corner Pair 1 -----
! (XMAX,YMAX,ZMAX) - (XMIN,YMIN,ZMIN)

N1=NODE(XMAX,YMAX,ZMAX)
N0=NODE(XMIN,YMIN,ZMIN)

CE,NEXT, DUXY,N1,UX,1,N0,UX,-1
CE,NEXT, DUYX,N1,UY,1,N0,UY,-1
CE,NEXT, 0,    N1,UZ,1,N0,UZ,-1


! ----- Corner Pair 2 -----
! (XMAX,YMAX,ZMIN) - (XMIN,YMIN,ZMAX)

ALLSEL,ALL
N1=NODE(XMAX,YMAX,ZMIN)
N0=NODE(XMIN,YMIN,ZMAX)

CE,NEXT, DUXY,N1,UX,1,N0,UX,-1
CE,NEXT, DUYX,N1,UY,1,N0,UY,-1
CE,NEXT, 0,    N1,UZ,1,N0,UZ,-1


! ----- Corner Pair 3 -----
! (XMIN,YMAX,ZMAX) - (XMAX,YMIN,ZMIN)

ALLSEL,ALL
N1=NODE(XMIN,YMAX,ZMAX)
N0=NODE(XMAX,YMIN,ZMIN)

CE,NEXT, DUXY,N1,UX,1,N0,UX,-1
CE,NEXT,-DUYX,N1,UY,1,N0,UY,-1
CE,NEXT, 0,    N1,UZ,1,N0,UZ,-1


! ----- Corner Pair 4 -----
! (XMAX,YMIN,ZMAX) - (XMIN,YMAX,ZMIN)

ALLSEL,ALL
N1=NODE(XMAX,YMIN,ZMAX)
N0=NODE(XMIN,YMAX,ZMIN)

CE,NEXT,-DUXY,N1,UX,1,N0,UX,-1
CE,NEXT, DUYX,N1,UY,1,N0,UY,-1
CE,NEXT, 0,    N1,UZ,1,N0,UZ,-1


! 12. REMOVE RIGID-BODY TRANSLATION
! Fix one reference corner

ALLSEL,ALL

NREF=NODE(XMIN,YMIN,ZMIN)

D,NREF,UX,0
D,NREF,UY,0
D,NREF,UZ,0


! 13. FINISH

ALLSEL,ALL

/GOP

/COM,===============================================
/COM, PERIODIC SHEAR CONSTRAINT GENERATION COMPLETE
/COM,===============================================
/COM, Number of unmatched face node pairs:
*STATUS,BADPAIR
/COM,===============================================

FINISH
/SOLU
